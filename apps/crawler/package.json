{
  "name": "@custom-wayback/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local ingestion of one domain and one month from the Wayback Machine into a browsable local mirror (plan.md Phase 1).",
  "bin": {
    "crawl": "./src/cli.ts"
  },
  "scripts": {
    "crawl": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts crawl",
    "serve": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts serve",
    "stats": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts stats",
    "dev": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@custom-wayback/shared": "workspace:*",
    "dotenv": "16.4.7",
    "linkedom": "0.18.5",
    "ulid": "2.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1"
  }
}
