{
  "name": "@custom-wayback/crawler-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local ingestion of one domain and one month from the Wayback Machine, through your own connection: a browsable local mirror, publishable to a deployed viewer's R2 (npm run publish).",
  "bin": {
    "crawl-local": "./src/cli.ts"
  },
  "scripts": {
    "crawl": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts crawl",
    "serve": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts serve",
    "stats": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts stats",
    "login": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts login",
    "publish": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts publish",
    "dev": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning --test src/*.test.ts"
  },
  "dependencies": {
    "@custom-wayback/pipeline": "workspace:*",
    "@custom-wayback/shared": "workspace:*",
    "linkedom": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.10.1"
  }
}
