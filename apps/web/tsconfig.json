{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "virtual:pwa-register/react": [
        "./node_modules/vite-plugin-pwa/react.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["src/sw.ts"]
}
