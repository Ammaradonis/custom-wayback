{
  "name": "@custom-wayback/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:css": "node scripts/verify-css.mjs",
    "check:visual": "node scripts/visual-check.mjs",
    "check:mobile": "node scripts/mobile-check.mjs",
    "test:e2e": "node scripts/e2e-calendar.mjs",
    "verify:ui": "npm run check:contrast && npm run check:css && npm run check:visual && npm run test:e2e && npm run check:mobile"
  },
  "dependencies": {
    "@custom-wayback/shared": "workspace:*",
    "@radix-ui/react-dialog": "1.1.3",
    "@radix-ui/react-popover": "1.1.3",
    "@radix-ui/react-slot": "1.1.1",
    "@tanstack/react-query": "5.62.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.0.2",
    "tailwind-merge": "2.5.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.0-beta.8",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "tailwindcss": "4.0.0-beta.8",
    "vite": "6.0.3",
    "vite-plugin-pwa": "0.21.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
